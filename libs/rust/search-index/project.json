{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "search-index",
  "projectType": "library",
  "tags": ["type:rust", "domain:search", "lang:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build",
        "cwd": "libs/rust/search-index"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test",
        "cwd": "libs/rust/search-index"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "commands": ["cargo clippy --all-targets -- -D warnings", "cargo fmt --check"],
        "parallel": false,
        "cwd": "libs/rust/search-index"
      }
    }
  }
}
