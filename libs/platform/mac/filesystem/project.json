{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "mac-filesystem",
  "projectType": "library",
  "tags": ["type:platform", "platform:mac", "lang:swift"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "swift build",
        "cwd": "libs/platform/mac/filesystem"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "options": {
        "command": "swift test",
        "cwd": "libs/platform/mac/filesystem"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": ["default", "{workspaceRoot}/.swift-format", "{workspaceRoot}/.swiftlint.yml"],
      "options": {
        "commands": [
          "swift format lint --strict --parallel --recursive Sources Tests Package.swift",
          "../../../../tools/swiftlint.sh lint --strict --quiet --config ../../../../.swiftlint.yml Sources Tests Package.swift"
        ],
        "parallel": false,
        "cwd": "libs/platform/mac/filesystem"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "swift format --in-place --parallel --recursive Sources Tests Package.swift",
          "../../../../tools/swiftlint.sh --fix --quiet --config ../../../../.swiftlint.yml Sources Tests Package.swift"
        ],
        "parallel": false,
        "cwd": "libs/platform/mac/filesystem"
      }
    }
  }
}
