{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "@platform/node-scaffolding",
  "projectType": "library",
  "tags": ["type:platform", "platform:node", "lang:ts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm exec tsdown",
        "cwd": "libs/platform/node/scaffolding"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit",
        "cwd": "libs/platform/node/scaffolding"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --passWithNoTests",
        "cwd": "libs/platform/node/scaffolding"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec oxlint --config ../../../../.oxlintrc.json .",
        "cwd": "libs/platform/node/scaffolding"
      }
    }
  }
}
