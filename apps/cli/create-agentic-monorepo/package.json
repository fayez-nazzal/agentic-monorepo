  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@domains/scaffolding": "workspace:*",
    "@platform/node-scaffolding": "workspace:*",
    "cross-spawn": "7.0.6",
    "picocolors": "1.1.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:cli",
      "lang:ts"
    ]
  }
