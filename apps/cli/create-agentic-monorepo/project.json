{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "create-agentic-monorepo",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:ts"],
  "targets": {
    "build": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/libs/domains/scaffolding/**/*",
        "{workspaceRoot}/libs/platform/node/scaffolding/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs/architecture.md",
        "{workspaceRoot}/tools/check-boundaries.mjs",
        "{workspaceRoot}/tools/architecture-acceptance.mjs",
        "{workspaceRoot}/tools/preflight-tui.mjs",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{projectRoot}/scripts/package.mjs"
      ],
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
